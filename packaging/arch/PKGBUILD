# Maintainer: xeon <xeon.productions@gmail.com>
#
# Builds from a source tarball next to this file:
#   git archive --prefix=xeondesktop-$pkgver/ -o packaging/arch/xeondesktop-$pkgver.tar.gz HEAD
# packaging/build-arch.sh does that and runs makepkg (also used by CI).
pkgname=xeondesktop
pkgver=0.5.0
pkgrel=1
pkgdesc='Desktop environment in the style of Windows 2000 and XP (Wayland, wlroots)'
arch=('x86_64' 'aarch64')
url='https://github.com/xeons/xeondesktop'
license=('MIT')
depends=(
  'wlroots0.20'
  'wayland'
  'libxkbcommon'
  'cairo'
  'pango'
  'ttf-dejavu'              # DejaVu Sans Condensed for Tahoma
  'adobe-source-sans-fonts' # Source Sans 3 for Trebuchet MS
  'ttf-roboto'              # Roboto Condensed for Franklin Gothic
  'ttf-opensans'            # Open Sans for Segoe UI (Aero)
  'glib2'
  'gtk3'
  'gtk-layer-shell'  # the Snipping Tool's overlay
  'gstreamer'        # screen recording
  'gst-plugins-base-libs'
  'gdk-pixbuf2'
  'procps-ng'
  'systemd-libs'
  'polkit'
  'pam'
  'shadow'  # passwd, for Change Password
  'dbus'    # dbus-update-activation-environment
  'libpulse'
  'libcanberra'
  'libxcrypt'  # User Accounts: password hashes
  'libinput'   # Mouse Properties, applied by the compositor
  'libxcursor' # Mouse Properties: pointer previews
  'fontconfig' # Fonts
  'libevdev'   # Game Controllers
  'libnm'      # Network Connections
  'packagekit' # Add or Remove Programs
  'flatpak'    # Add or Remove Programs
  'libsoup3'   # Automatic Updates: firmware downloads
  'libcups'    # Printers and Faxes
  'sane'       # Scanners and Cameras
  'libgphoto2' # Scanners and Cameras
  'nut'        # Power Options' UPS tab: libupsclient
  'gpgme'      # Passwords and Keys: PGP keys
  'libsecret'  # Passwords and Keys: stored passwords
  'libarchive' # Files: Send To > Compressed (zipped) Folder
  'libsecret'  # Files: remembered passphrases of encrypted drives
  'libseccomp' # xd-thumbnailer's sandbox
  'bubblewrap' # xd-thumbnailer's sandbox
  'iso-codes'  # the language bar's two-letter codes
  'json-glib'
  'libglvnd'  # EGL/GLESv2: xd-compositor-fx
  'pixman'
  'lcms2'     # monitor calibration curves (vcgt)
  'liburing'  # Disk Benchmark and Health: io_uring
  'sh'
)
# Header-only at build time: xcb-icccm's hint structures, libdrm's formats.
# mesa: EGL/GLES headers for SceneFX (xd-compositor-fx, Aero's blur).
# xdg-desktop-portal: the file chooser portal's D-Bus interfaces.
makedepends=('meson' 'ninja' 'wayland-protocols' 'libxcb' 'xcb-util-wm' 'libdrm' 'mesa'
             'xdg-desktop-portal')
checkdepends=('ttf-dejavu' 'openssh' 'gnupg')
optdepends=(
  'xorg-xwayland: X11 applications'
  "egl-gbm: NVIDIA's proprietary driver (the compositor draws through GBM)"
  'gst-plugins-good: screen recording (MP4, sound)'
  'gst-plugins-bad: screen recording (h264parse)'
  'gst-plugins-ugly: screen recording (x264; or OpenH264 from gst-plugins-bad)'
  'gst-libav: screen recording with sound (AAC)'
  'breeze-icons: icons for the Start menu and file manager'
  'oxygen-icons: the Oxygen icon theme (Display Properties > Linux)'
  'papirus-icon-theme: the Papirus icon theme (Display Properties > Linux)'
  'mate-icon-theme: the MATE icon theme (Display Properties > Linux)'
  'xdg-desktop-portal: our Open and Save As dialogs for Flatpaks, GTK 4, Firefox, Chromium'
  'xdg-desktop-portal-gtk: settings and other portals'
  'xdg-desktop-portal-wlr: screenshot and screen sharing portals'
  'accountsservice: User Accounts'
  'gnome-keyring: Passwords and Keys (or another Secret Service, such as KeePassXC)'
  'openssh: Passwords and Keys > SSH Keys'
  'bluez: Bluetooth Devices'
  'udisks2: Disk Management; Disk Benchmark and Health (Health)'
  'cups: Printers and Faxes'
  'nm-connection-editor: Network Connections > Configure and Advanced'
  'alacritty: the default terminal (Ctrl+Alt+T)'
  'networkmanager: the network icon'
  'nm-connection-editor: Open Network Connections'
  'upower: the battery icon'
  'fwupd: Automatic Updates: firmware updates and Device Security'
  'bluez: the Bluetooth icon'
  'blueman: Bluetooth Devices...'
  'pavucontrol: Open Volume Control'
  'pipewire-pulse: the volume icon (or PulseAudio)'
  'sound-theme-freedesktop: the default sound scheme'
  'colord: Color Management'
  'geoclue: Night Light finding sunset and sunrise by itself; Privacy > Location'
  'fcitx5: an input method (Keyboard > Text Services; with fcitx5-gtk, fcitx5-qt, fcitx5-configtool)'
  'ibus: an input method (Keyboard > Text Services)'
  'switcheroo-control: Run with dedicated graphics card'
  'gvfs-smb: Map Network Drive to Windows shares; My Network Places'
  'gvfs-nfs: Map Network Drive to NFS shares'
  'samba: a folder Properties Sharing tab (Samba user shares)'
  'python-pefile: importing Windows visual styles (xd-theme-import)'
  'python-gobject: importing Windows visual styles (xd-theme-import)'
  'python-cairo: importing Windows Vista and 7 visual styles (xd-theme-import)'
  'aisleriot: Solitaire and FreeCell (Start > Programs > Games)'
)
backup=('etc/pam.d/xeondesktop')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  # The project's defaults are a sanitizer debug build for development.
  arch-meson "$pkgname-$pkgver" build -Db_sanitize=none -Dwerror=false -Daero_blur=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir" --skip-subprojects
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
