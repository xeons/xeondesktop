# ---- uxtheme's names (data/theme/uxtheme.ini) ------------------------------------------


def names_file():
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (
        os.environ.get("XD_UXTHEME_NAMES"),
        os.path.join(here, "..", "data", "theme", "uxtheme.ini"),
        os.path.join(here, "..", "share", "xeondesktop", "theme", "uxtheme.ini"),
        "/usr/share/xeondesktop/theme/uxtheme.ini",
    ):
        if path and os.path.exists(path):
            return path
    sys.exit("xd-theme-import: uxtheme.ini not found")


class Names:
    """Property ids and types, enums, and each class's parts and states."""

    def __init__(self, path):
        cp = configparser.ConfigParser(interpolation=None, delimiters=("=",),
                                       comment_prefixes=("#",))
        cp.optionxform = str  # keep the spelling
        cp.read(path, encoding="utf-8")
        self.prop_by_id, self.prop_type, self.prop_name = {}, {}, {}
        self.missing = set()
        for name, value in cp["Properties"].items():
            pid, _, typ = value.partition(";")
            self.prop_by_id.setdefault(int(pid), name)
            self.prop_type[name.lower()] = typ.upper()
            self.prop_name[name.lower()] = name
        self.enums = {}
        self.parts, self.states = {}, {}
        # "[Deduced Class Version]": names for an undocumented class's parts
        # in a style of that Windows version ("6.1").
        self.deduced = {}
        for sec in cp.sections():
            kind, _, what = sec.partition(" ")
            if kind == "Deduced":
                cls, _, version = what.partition(" ")
                self.deduced[(cls.lower(), version)] = {int(v): k for k, v in cp[sec].items()}
                continue
            if kind not in ("Enum", "Parts", "States"):
                continue
            values = {k: int(v) for k, v in cp[sec].items()}
            if kind == "Enum":
                self.enums[what.lower()] = {v: k for k, v in values.items()}
            elif kind == "Parts":
                self.parts[what.lower()] = values
            elif kind == "States":
                self.states[what.lower()] = values

    @staticmethod
    def base(cls):
        return cls.split("::")[-1].lower()

    def part_name(self, cls, number, version=None):
        for name, n in self.parts.get(self.base(cls), {}).items():
            if n == number:
                return name
        return self.deduced.get((self.base(cls), version), {}).get(number, str(number))

    def state_name(self, cls, part, number):
        for name, n in self.states.get(f"{self.base(cls)}.{part.lower()}", {}).items():
            if n == number:
                return name
        return str(number)

    def enum_name(self, prop, number):
        return self.enums.get(prop.lower(), {}).get(number, str(number))

    def canonical(self, prop):
        return self.prop_name.get(prop.lower(), prop)

    def value(self, prop, value):
        """A value spelled as the table spells it: enum names, booleans."""
        typ = self.prop_type.get(prop.lower())
        if typ == "ENUM":
            for name in self.enums.get(prop.lower(), {}).values():
                if name.lower() == value.lower():
                    return name
        elif typ == "BOOL" and value.lower() in ("true", "false", "1", "0"):
            return "true" if value.lower() in ("true", "1") else "false"
        return value


# ---- reading PE resources ----------------------------------------------------------------


class Resources:
    def __init__(self, path):
        self.pe = pefile.PE(path, fast_load=True)
        self.pe.parse_data_directories(
            directories=[pefile.DIRECTORY_ENTRY["IMAGE_DIRECTORY_ENTRY_RESOURCE"]])
        self.res = {}
        root = getattr(self.pe, "DIRECTORY_ENTRY_RESOURCE", None)
        for t in root.entries if root else []:
            tname = str(t.name) if t.name is not None else t.struct.Id
            for e in t.directory.entries:
                ename = str(e.name) if e.name is not None else e.struct.Id
                for lang in e.directory.entries:
                    d = lang.data.struct
                    self.res.setdefault((tname, ename), self.pe.get_data(d.OffsetToData, d.Size))

    def get(self, kind, name):
        if isinstance(name, str):
            for (k, n), data in self.res.items():
                if k == kind and isinstance(n, str) and n.upper() == name.upper():
                    return data
            return None
        return self.res.get((kind, name))

    def names(self, kind):
        return [n for (k, n) in self.res if k == kind]

    def string(self, sid):
        """A string table entry (RT_STRING = 6: blocks of 16)."""
        block = self.res.get((6, sid // 16 + 1))
        if block is None:
            return None
        off = 0
        for i in range(16):
            (n,) = struct.unpack_from("<H", block, off)
            off += 2
            if i == sid % 16:
                return block[off:off + 2 * n].decode("utf-16-le")
            off += 2 * n
        return None


def utf16(data):
    return data.decode("utf-16-le").lstrip("﻿").rstrip("\0")


# ---- images ------------------------------------------------------------------------------


def pixbuf_from_bmp_resource(data):
    """A bitmap resource (no file header) as a pixbuf. XP's 32-bit bitmaps
    keep straight alpha in the fourth byte, which bitmap readers take for
    padding: those rows go to GdkPixbuf as they are."""
    header, width, height, _planes, bpp, compression = struct.unpack_from("<IiiHHI", data, 0)
    if bpp == 32 and compression == 0:
        h = abs(height)
        stride = width * 4
        bits = data[header:header + stride * h]
        rows = [bits[i * stride:(i + 1) * stride] for i in range(h)]
        if height > 0:
            rows.reverse()  # stored bottom-up
        rgba = bytearray(b"".join(rows))
        rgba[0::4], rgba[2::4] = rgba[2::4], rgba[0::4]  # BGRA -> RGBA
        if not any(rgba[3::4]):
            rgba[3::4] = b"\xff" * (width * h)  # no alpha: opaque, as uxtheme takes it
        return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(rgba)),
                                               GdkPixbuf.Colorspace.RGB, True, 8,
                                               width, h, stride)
    colors = struct.unpack_from("<I", data, 32)[0]
    if colors == 0 and bpp <= 8:
        colors = 1 << bpp
    offset = 14 + header + 4 * colors
    if compression == 3:
        offset += 12  # BI_BITFIELDS masks
    bmp = b"BM" + struct.pack("<IHHI", 14 + len(data), 0, 0, offset) + data
    loader = GdkPixbuf.PixbufLoader.new_with_type("bmp")
    loader.write(bmp)
    loader.close()
    return loader.get_pixbuf()


def pixbuf_from_png(data):
    loader = GdkPixbuf.PixbufLoader.new_with_type("png")
    loader.write(data)
    loader.close()
    return loader.get_pixbuf()


def png_from_premultiplied(data):
    """Vista's and 7's PNGs hold premultiplied colour (no pixel is brighter
    than its alpha): as straight-alpha PNG, by cairo, whose ARGB32 is
    premultiplied and which writes PNGs straight."""
    import cairo

    pb = pixbuf_from_png(data)
    if not pb.get_has_alpha():
        return pb
    w, h, stride = pb.get_width(), pb.get_height(), pb.get_rowstride()
    src = pb.get_pixels()
    cstride = cairo.ImageSurface.format_stride_for_width(cairo.FORMAT_ARGB32, w)
    out = bytearray(cstride * h)
    for y in range(h):
        row = src[y * stride:y * stride + w * 4]
        o = y * cstride
        # RGBA -> cairo's native-endian ARGB32: B, G, R, A in memory on
        # little-endian machines, A, R, G, B on big-endian ones.
        order = (2, 1, 0, 3) if sys.byteorder == "little" else (3, 0, 1, 2)
        for i, channel in enumerate(order):
            out[o + i:o + w * 4:4] = row[channel::4]
    surface = cairo.ImageSurface.create_for_data(out, cairo.FORMAT_ARGB32, w, h, cstride)
    buf = io.BytesIO()
    surface.write_to_png(buf)
    return pixbuf_from_png(buf.getvalue())


def png_bytes(pixbuf):
    ok, buf = pixbuf.save_to_bufferv("png", [], [])
    if not ok:
        raise RuntimeError("PNG encoding failed")
    return bytes(buf)


def parse_color(value):
    nums = [int(x) for x in re.findall(r"-?\d+", value)]
    return tuple(nums[:3]) if len(nums) >= 3 else None


# ---- the package being written ------------------------------------------------------------


class Package:
    def __init__(self):
        self.files = {}  # path -> bytes
        self.images = {}  # key -> path

    def add(self, path, data):
        self.files[path] = data

    def image(self, key, path, make):
        """Adds an image once per key; returns its path in the package."""
        if key not in self.images:
            pixbuf = make()
            if pixbuf is None:
                return None
            base, n = path, 2
            while path in self.files:
                path = f"{os.path.splitext(base)[0]}-{n}.png"
                n += 1
            self.add(path, png_bytes(pixbuf))
            self.images[key] = path
        return self.images[key]

    def write(self, output, folder):
        if folder:
            for path, data in self.files.items():
                full = os.path.join(output, path)
                os.makedirs(os.path.dirname(full), exist_ok=True)
                with open(full, "wb") as f:
                    f.write(data)
            return
        tmp = output + ".part"
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
            # theme.xml first: a reader finds it at once.
            for path in sorted(self.files, key=lambda p: (p != "theme.xml", p)):
                z.writestr(path, self.files[path])
        os.replace(tmp, output)


def xml_bytes(root):
    ET.indent(root)
    return ET.tostring(root, encoding="utf-8", xml_declaration=True) + b"\n"


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "default"


# Properties naming image files, and the ones naming glyph images.
IMAGE_PROPS = {"imagefile", "stockimagefile"} | {f"imagefile{i}" for i in range(1, 8)}
GLYPH_PROPS = {"glyphimagefile"}
# Typed values written as space-separated numbers.
NUMBER_TYPES = {"COLOR", "MARGINS", "POSITION", "SIZE", "RECT", "INTLIST"}

# The part and state in a section name: "App::Class.Part(State)".
SECTION = re.compile(r"^\s*([^.(]+?)\s*(?:\.\s*([^(]+?))?\s*(?:\(\s*(.+?)\s*\))?\s*$")


class Style:
    """One variant's styles/NAME.xml, built up section by section."""

    def __init__(self, names):
        self.names = names
        self.root = ET.Element("style")
        self.sysmetrics = ET.SubElement(self.root, "sysmetrics")
        self.classes = {}

    def klass(self, name):
        key = name.lower()
        if key not in self.classes:
            self.classes[key] = ET.SubElement(self.root, "class", name=name)
        return self.classes[key]

    def part(self, cls, part, state, props):
        attrs = {}
        if part:
            attrs["name"] = part
        if state:
            attrs["state"] = state
        el = ET.SubElement(self.klass(cls), "part", attrs)
        for k, v in props:
            el.set(self.names.canonical(k), v)


# ---- Windows XP: INI text and bitmaps -----------------------------------------------------

SYSMETRIC_COLORS = {
    "scrollbar", "background", "activecaption", "inactivecaption", "menu", "window",
    "windowframe", "menutext", "windowtext", "captiontext", "activeborder", "inactiveborder",
    "appworkspace", "highlight", "highlighttext", "btnface", "btnshadow", "graytext",
    "btntext", "inactivecaptiontext", "btnhighlight", "dkshadow3d", "light3d", "infotext",
    "infobk", "buttonalternateface", "hottracking", "gradientactivecaption",
    "gradientinactivecaption", "menuhilight", "menubar",
}


def sysmetric(style, key, value):
    k = key.lower()
    canon = style.names.canonical(key)
    if k in SYSMETRIC_COLORS:
        ET.SubElement(style.sysmetrics, "color", name=canon, value=" ".join(map(str, parse_color(value) or ())))
    elif k.endswith("font"):
        face, *rest = [p.strip() for p in value.split(",")]
        attrs = {"name": canon, "face": face}
        if rest:
            attrs["size"] = rest[0]
        # Flags: "bold", "italic", "underline", "Quality:ClearType".
        for flag in rest[1:]:
            key, _, val = flag.partition(":")
            key = key.strip().lower()
            if key in ("bold", "italic", "underline"):
                attrs[key] = "true"
            elif key and re.fullmatch(r"[a-z]+", key):
                attrs[key] = val.strip().lower() or "true"
        ET.SubElement(style.sysmetrics, "font", attrs)
    elif value.strip().lower() in ("true", "false"):
        ET.SubElement(style.sysmetrics, "bool", name=canon, value=value.strip().lower())
    else:
        ET.SubElement(style.sysmetrics, "value", name=canon, value=value.strip())


def ini(text):
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",), comment_prefixes=(";",),
                                   strict=False, interpolation=None)
    cp.optionxform = str
    cp.read_string(text)
    return cp


def xp_image(pkg, res, variant, ref, transparent):
    """An XP image file reference ("Blue\\Button.bmp") as a package PNG,
    with its transparent colour (magenta) made alpha."""
    resname = re.sub(r"[\\/.]", "_", ref.strip()).upper()
    data = res.get(2, resname)  # RT_BITMAP
    if data is None:
        return None
    key = (resname, transparent)
    path = "images/" + "/".join(p.lower() for p in re.split(r"[\\/]", ref.strip()))
    path = os.path.splitext(path)[0] + ".png"

    def make():
        pb = pixbuf_from_bmp_resource(data)
        if transparent is not None:
            # The colour becomes clear whether or not the bitmap has alpha
            # of its own (add_alpha keeps what alpha there is).
            pb = pb.add_alpha(True, *transparent)
        return pb

    return pkg.image(key, path, make)


def import_xp(res, names, pkg):
    themes = ini(utf16(res.get("TEXTFILE", "THEMES_INI")))
    doc = themes["documentation"] if themes.has_section("documentation") else {}
    info = {"base": "luna", "name": doc.get("DisplayName", "Imported style").strip(),
            "author": doc.get("Author", "").strip(), "description": doc.get("Description", "").strip()}
    variants = []
    for sec in themes.sections():
        if not sec.lower().startswith("file."):
            continue
        fid = sec.split(".", 1)[1]
        text = res.get("TEXTFILE", fid.upper() + "_INI")
        if text is None:
            continue
        color = themes[sec].get("ColorSchemes", "").split()[0] if themes[sec].get("ColorSchemes") else ""
        size = themes[sec].get("Sizes", "").split()[0] if themes[sec].get("Sizes") else ""
        cname = themes.get(f"ColorScheme.{color}", "DisplayName", fallback=color).strip()
        sname = themes.get(f"Size.{size}", "DisplayName", fallback=size).strip()
        style = Style(names)
        cp = ini(utf16(text))
        # Properties by (class, part, state), lowercase, to look up what a
        # section inherits from its class and the globals, as uxtheme does.
        table = {}
        for section in cp.sections():
            m = SECTION.match(section)
            if m:
                key = tuple((x or "").strip().lower() for x in m.groups())
                table.setdefault(key, {}).update({k.lower(): v.strip() for k, v in cp[section].items()})

        def inherited(cls, part, state, prop):
            c, p_, st = ((x or "").strip().lower() for x in (cls, part, state))
            for key in ((c, p_, st), (c, p_, ""), (c, "", ""), (c.split("::")[-1], p_, ""),
                        (c.split("::")[-1], "", ""), ("globals", "", "")):
                if prop in table.get(key, {}):
                    return table[key][prop]
            return None

        for section in cp.sections():
            m = SECTION.match(section)
            if not m:
                continue
            cls, part, state = m.groups()
            props = list(cp[section].items())
            if cls.lower() == "sysmetrics":
                for k, v in props:
                    sysmetric(style, k, v)
                continue
            if cls.lower() == "documentation":
                continue
            def flag(prop):
                v = inherited(cls, part, state, prop)
                return v is not None and v.lower() in ("true", "1")

            def prop_color(prop):
                v = inherited(cls, part, state, prop)
                return parse_color(v) if v else None

            transparent_on, tcolor = flag("transparent"), prop_color("transparentcolor")
            glyph_on, gcolor = flag("glyphtransparent"), prop_color("glyphtransparentcolor")
            # An image glyph without a GlyphImageFile has its sizes in
            # ImageFile1..N (XP's caption buttons): glyph transparency.
            glyph_sizes = (inherited(cls, part, state, "glyphtype") or "").lower() == "imageglyph" \
                and inherited(cls, part, state, "glyphimagefile") is None
            out = []
            for k, v in props:
                kl = k.lower()
                v = v.strip()
                if kl in IMAGE_PROPS or kl in GLYPH_PROPS:
                    as_glyph = kl in GLYPH_PROPS or (glyph_sizes and kl != "imagefile")
                    on, col = (glyph_on, gcolor) if as_glyph else (transparent_on, tcolor)
                    path = xp_image(pkg, res, color, v, (col or (255, 0, 255)) if on else None)
                    if path is None:
                        print(f"xd-theme-import: {section}: no image {v}", file=sys.stderr)
                        continue
                    v = path
                elif kl in ("transparentcolor", "glyphtransparentcolor"):
                    continue  # now in the images' alpha
                elif names.prop_type.get(kl) in NUMBER_TYPES:
                    v = " ".join(re.findall(r"-?\d+", v))
                else:
                    v = names.value(k, v)
                out.append((k, v))
            style.part(cls, part, state, out)
        vid = slug(f"{cname}-{sname}")
        path = f"styles/{vid}.xml"
        pkg.add(path, xml_bytes(style.root))
        variants.append({"id": vid, "name": cname, "size": sname, "style": path,
                         "color_key": color, "size_key": size})
    return info, variants


# ---- Windows Vista and 7: the binary property table and PNGs -------------------------------

TYPE_NAMES = {200: "ENUM", 201: "STRING", 202: "INT", 203: "BOOL", 204: "COLOR", 205: "MARGINS",
              206: "FILENAME", 207: "SIZE", 208: "POSITION", 209: "RECT", 210: "FONT",
              211: "INTLIST", 212: "HBITMAP", 213: "DISKSTREAM", 214: "STREAM",
              215: "BITMAPREF", 216: "FLOAT", 217: "FLOATLIST"}


def class_map(data):
    """CMAP: class names, each null-terminated UTF-16 and padded to 8 bytes."""
    out, i = [], 0
    while i < len(data):
        j = i
        while j + 1 < len(data) and data[j:j + 2] != b"\0\0":
            j += 2
        out.append(data[i:j].decode("utf-16-le"))
        i = (j + 2 + 7) & ~7
    return out


def variant_records(data):
    """VARIANT: records of a 32-byte header (property, type, class, part,
    state, a short value, reserved, size) and size bytes padded to 8; a
    non-zero short value is the value itself (a resource id) with no data."""
    off = 0
    while off + 32 <= len(data):
        nid, tid, cls, part, state, short, _reserved, size = struct.unpack_from("<8i", data, off)
        off += 32
        if short != 0:
            yield nid, tid, cls, part, state, short, None
            continue
        yield nid, tid, cls, part, state, None, data[off:off + size]
        off += (size + 7) & ~7


def font_value(text):
    """"Segoe UI, 9, Bold" as XP writes fonts."""
    return text.strip() if text else None


def import_vista(res, names, pkg, mui):
    cmap = class_map(res.get("CMAP", "CMAP"))
    fixed = getattr(res.pe, "VS_FIXEDFILEINFO", None)
    version = f"{fixed[0].FileVersionMS >> 16}.{fixed[0].FileVersionMS & 0xFFFF}" if fixed else None
    style = Style(names)
    info = {"base": "aero", "name": "Imported style", "author": "", "description": ""}
    groups = {}
    order = []

    def string(sid):
        for r in (mui, res):
            if r is not None:
                s = r.string(sid)
                if s is not None:
                    return s
        return None

    for nid, tid, ci, part, state, short, raw in variant_records(res.get("VARIANT", "NORMAL")):
        cls = cmap[ci] if 0 <= ci < len(cmap) else str(ci)
        prop = names.prop_by_id.get(nid)
        if prop is None:
            prop = f"Property{nid}"  # not in uxtheme.ini: kept by number
            names.missing.add(nid)
        typ = TYPE_NAMES.get(tid, str(tid))
        if short is not None:
            if typ == "FILENAME":
                data = res.get("IMAGE", short)
                value = pkg.image(("IMAGE", short), f"images/{short}.png",
                                  lambda d=data: png_from_premultiplied(d) if d else None)
            elif typ == "DISKSTREAM":
                data = res.get("STREAM", short)
                value = pkg.image(("STREAM", short), f"images/stream-{short}.png",
                                  lambda d=data: png_from_premultiplied(d) if d else None)
            elif typ in ("FONT", "STRING"):
                value = font_value(string(short)) if typ == "FONT" else string(short)
            else:
                value = str(short)
            if value is None:
                continue
        elif typ in ("INT", "BOOL", "ENUM"):
            (n,) = struct.unpack_from("<i", raw)
            value = ("true" if n else "false") if typ == "BOOL" else \
                names.enum_name(prop, n) if typ == "ENUM" else str(n)
        elif typ == "COLOR":
            value = "%d %d %d" % tuple(raw[:3])
        elif typ in ("MARGINS", "RECT", "POSITION", "SIZE"):
            # A size is one number (a length), a position two.
            value = " ".join(map(str, struct.unpack_from(f"<{len(raw) // 4}i", raw)))
        elif typ == "INTLIST":
            (n,) = struct.unpack_from("<i", raw)
            value = " ".join(map(str, struct.unpack_from(f"<{n}i", raw, 4)))
        elif typ == "FLOAT":
            value = repr(struct.unpack_from("<f", raw)[0])
        elif typ == "STRING":
            value = raw.decode("utf-16-le").rstrip("\0")
        else:
            continue  # nothing the renderer reads
        low = cls.lower()
        if low == "documentation":
            if prop.lower() in ("displayname", "author", "description"):
                info[{"displayname": "name"}.get(prop.lower(), prop.lower())] = value
            continue
        if low == "sysmetrics":
            sysmetric(style, prop, value)
            continue
        if low.startswith(("colorvariant.", "sizevariant.")):
            continue
        key = (cls, part, state)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append((prop, value))
    for cls, part, state in order:
        pname = names.part_name(cls, part, version) if part else None
        sname = names.state_name(cls, pname, state) if part and state else (str(state) if state else None)
        style.part(cls, pname, sname, groups[(cls, part, state)])
    path = "styles/normal.xml"
    pkg.add(path, xml_bytes(style.root))
    return info, [{"id": "normal", "name": "Default", "size": "Normal", "style": path,
                   "color_key": "NormalColor", "size_key": "NormalSize"}]


# ---- Windows XP's shellstyle.dll: DirectUI stylesheets --------------------------------------
#
# XP's Explorer draws its task pane (and the "blockade" over system folders)
# with DirectUI, styled by stylesheets in shellstyle.dll's UIFILE resources:
#
#     <style resid=sectionss>
#     button [id=atom(header)][mousefocused]
#     {
#     background: rcbmp(112,6,#FF00FF,0,0,1,0);
#     padding: rect(10rp,0rp,1rp,0rp);
#     fontsize: rcint(15)pt;
#     }
#     </style>
#
# CSS-like, but not CSS (no library reads it, and a CSS parser would choke on
# the unquoted <style> tags and the function syntax), so this is a small
# tokenizer and parser for exactly what XP's stylesheets contain: <style
# resid=NAME> blocks of rules; a rule is an element type with [name] or
# [name=value] conditions, then { property: value; ... }; a value is
# numbers (with a unit: rp, pt), names, #RRGGBB, function calls (rgb(),
# rcint(), rect()...) and "|" between flags. Anything else is an error.


class DuiError(ValueError):
    pass


DUI_TOKEN = re.compile(r"""
    (?P<space>\s+)
  | (?P<open><\s*style\s+resid\s*=\s*"?(?P<resid>\w+)"?\s*>)
  | (?P<close><\s*/\s*style\s*>)
  | (?P<number>-?\d+(?:\.\d+)?)(?P<unit>[A-Za-z]+)?
  | (?P<hash>\#[0-9A-Fa-f]{6}\b)
  | (?P<ident>[A-Za-z_][A-Za-z0-9_]*)
  | (?P<punct>[{}\[\]():;,=|])
""", re.X)


def dui_tokens(text):
    """(kind, value, start, end) for each token: open (the resid), close,
    number ((value, unit or None)), hash, ident, punct."""
    pos = 0
    while pos < len(text):
        m = DUI_TOKEN.match(text, pos)
        if m is None:
            line = text.count("\n", 0, pos) + 1
            raise DuiError(f"line {line}: unexpected {text[pos:pos + 12]!r}")
        kind = m.lastgroup
        if kind == "unit" or kind == "resid":
            kind = "number" if m.group("number") is not None else "open"
        if kind == "number":
            n = m.group("number")
            value = (float(n) if "." in n else int(n), m.group("unit"))
        elif kind == "open":
            value = m.group("resid")
        else:
            value = m.group(kind)
        if kind != "space":
            yield kind, value, m.start(), m.end()
        pos = m.end()


class DuiRule:
    """One rule: element type, conditions (name -> value or None), and
    declarations (property -> value, a list of terms). A term is
    ("num", n, unit), ("ident", name), ("hash", "#RRGGBB"), ("op", "|") or
    ("call", name, [arguments, each a list of terms], unit)."""

    def __init__(self, element, conds, decls):
        self.element, self.conds, self.decls = element, conds, decls


class DuiParser:
    def __init__(self, text):
        self.toks = list(dui_tokens(text))
        self.i = 0
        self.text = text

    def error(self, what):
        pos = self.toks[self.i][2] if self.i < len(self.toks) else len(self.text)
        raise DuiError(f"line {self.text.count(chr(10), 0, pos) + 1}: {what}")

    def peek(self):
        return self.toks[self.i] if self.i < len(self.toks) else (None, None, 0, 0)

    def take(self, kind=None, value=None):
        tok = self.peek()
        if tok[0] is None or (kind and tok[0] != kind) or (value and tok[1] != value):
            self.error(f"expected {value or kind}, found {tok[1]!r}")
        self.i += 1
        return tok

    def sheets(self):
        """{resid: [DuiRule]}, rules in order."""
        out = {}
        while self.peek()[0] is not None:
            resid = self.take("open")[1]
            rules = out.setdefault(resid, [])
            while self.peek()[0] != "close":
                rules.append(self.rule())
            self.take("close")
        return out

    def rule(self):
        element = self.take("ident")[1]
        conds = {}
        while self.peek()[1] == "[":
            self.take("punct", "[")
            name = self.take("ident")[1].lower()
            value = None
            if self.peek()[1] == "=":
                self.take("punct", "=")
                value = self.value(stop=("]",))
            conds[name] = value
            self.take("punct", "]")
        self.take("punct", "{")
        decls = {}
        while self.peek()[1] != "}":
            prop = self.take("ident")[1].lower()
            self.take("punct", ":")
            decls[prop] = self.value(stop=(";", "}"))
            if self.peek()[1] == ";":
                self.take("punct", ";")
        self.take("punct", "}")
        return DuiRule(element.lower(), conds, decls)

    def value(self, stop):
        terms = []
        while self.peek()[1] not in stop:
            kind, v, _start, end = self.take()
            if kind == "number":
                terms.append(("num", v[0], v[1]))
            elif kind == "hash":
                terms.append(("hash", v))
            elif kind == "punct" and v == "|":
                terms.append(("op", v))
            elif kind == "ident" and self.peek()[1] == "(":
                self.take("punct", "(")
                args = []
                while self.peek()[1] != ")":
                    args.append(self.value(stop=(",", ")")))
                    if self.peek()[1] == ",":
                        self.take("punct", ",")
                close = self.take("punct", ")")
                # A unit straight after the call: rcint(15)pt.
                unit = None
                nxt = self.peek()
                if nxt[0] == "ident" and nxt[2] == close[3] and nxt[1] in ("pt", "rp", "px"):
                    unit = self.take()[1]
                terms.append(("call", v.lower(), args, unit))
            elif kind == "ident":
                terms.append(("ident", v.lower()))
            else:
                self.error(f"unexpected {v!r} in a value")
        return terms


def parse_dui(text):
    return DuiParser(text).sheets()


DUI_COLORS = {"white": (255, 255, 255), "black": (0, 0, 0)}


class DuiValues:
    """Reads a stylesheet's values, resolving rcstr()/rcint() through the
    DLL's string table."""

    def __init__(self, sheets, string):
        self.sheets, self.string = sheets, string

    def rules(self, resid, element, id=None, flags=()):
        """The declarations of the rules for element with exactly that id
        and those flags, merged in order."""
        out = {}
        for r in self.sheets.get(resid, []):
            if r.element != element:
                continue
            rid = r.conds.get("id")
            rid = rid[0][2][0][0][1] if rid and rid[0][0] == "call" and rid[0][1] == "atom" else None
            others = {k for k in r.conds if k != "id"}
            if rid == (id.lower() if id else None) and others == set(flags):
                out.update(r.decls)
        return out

    def number(self, terms):
        if len(terms) != 1:
            return None
        t = terms[0]
        if t[0] == "num":
            return t[1]
        if t[0] == "call" and t[1] == "rcint" and len(t[2]) == 1:
            n = self.number(t[2][0])
            s = self.string(int(n)) if n is not None else None
            return int(s, 0) if s and re.fullmatch(r"\s*-?(0x[0-9a-fA-F]+|\d+)\s*", s) else None
        return None

    def text(self, terms):
        if len(terms) == 1 and terms[0][0] == "call" and terms[0][1] == "rcstr":
            n = self.number(terms[0][2][0])
            return self.string(int(n)) if n is not None else None
        if len(terms) == 1 and terms[0][0] == "ident":
            return terms[0][1]
        return None

    def color(self, terms):
        """(r, g, b, a), a 0 (clear) to 255, or None."""
        if len(terms) != 1:
            return None
        t = terms[0]
        if t[0] == "ident" and t[1] in DUI_COLORS:
            return DUI_COLORS[t[1]] + (255,)
        if t[0] == "hash":
            v = int(t[1][1:], 16)
            return (v >> 16, (v >> 8) & 255, v & 255, 255)
        if t[0] == "call" and t[1] in ("rgb", "argb"):
            n = [self.number(a) for a in t[2]]
            if None in n or len(n) != (3 if t[1] == "rgb" else 4):
                return None
            return tuple(n) + (255,) if t[1] == "rgb" else tuple(n[1:]) + (n[0],)
        return None

    def gradient(self, terms):
        """(from, to, vertical): DirectUI's gradients ignore their colours'
        alpha (XP writes them argb(0,...))."""
        if len(terms) == 1 and terms[0][0] == "call" and terms[0][1] == "gradient":
            args = terms[0][2]
            if len(args) == 3:
                a, b, mode = self.color(args[0]), self.color(args[1]), self.number(args[2])
                if a and b and mode is not None:
                    return a[:3], b[:3], mode == 1
        return None

    def rect(self, terms):
        """rect(left, top, right, bottom)."""
        if len(terms) == 1 and terms[0][0] == "call" and terms[0][1] == "rect":
            n = [self.number(a) for a in terms[0][2]]
            if len(n) == 4 and None not in n:
                return tuple(int(x) for x in n)
        return None

    def bitmap(self, terms):
        """rcbmp(id, mode, transparent colour, ...): (id, (r, g, b) or None).
        Only a #RRGGBB third argument is a colour; the arrows' 255 is
        immaterial, as their bitmaps carry alpha."""
        if len(terms) == 1 and terms[0][0] == "call" and terms[0][1] == "rcbmp":
            args = terms[0][2]
            n = self.number(args[0]) if args else None
            if n is None:
                return None
            trans = self.color(args[2]) if len(args) > 2 and args[2][:1] and args[2][0][0] == "hash" else None
            return int(n), (trans[:3] if trans else None)
        return None


def margins(rect):
    """DirectUI's rect(left, top, right, bottom) as uxtheme's MARGINS."""
    l, t, r, b = rect
    return f"{l} {r} {t} {b}"


def rgb(c):
    return "%d %d %d" % tuple(c[:3])


def shellstyle_xml(dll, pkg, color):
    """shell/NAME.xml for one colour scheme from its shellstyle.dll (see
    docs/THEMES.md, "shell/NAME.xml"); the bitmaps it uses become PNGs."""
    res = Resources(dll)
    text = []
    for (kind, _name), data in sorted(res.res.items(), key=lambda kv: str(kv[0][1])):
        if kind == "UIFILE":
            text.append(utf16(data) if data[1:2] == b"\0" else data.decode("cp1252"))

    def image(ref):
        rid, trans = ref
        data = res.get(2, rid)  # RT_BITMAP
        if data is None:
            return None

        def make():
            pb = pixbuf_from_bmp_resource(data)
            return pb.add_alpha(True, *trans) if trans else pb

        return pkg.image(("SHELL", dll, rid), f"images/shell/{slug(color)}/{rid}.png", make)

    return xml_bytes(shell_root(DuiValues(parse_dui("\n".join(text)), res.string), image))


def shell_root(v, bitmap):
    """The <shell> element from XP's stylesheets (DuiValues); bitmap((id,
    transparent colour)) makes a bitmap a package image and returns its
    path."""
    root = ET.Element("shell")
    classes = {}

    def part(cls, name, state=None, **props):
        if cls not in classes:
            classes[cls] = ET.SubElement(root, "class", name=cls)
        attrs = {}
        if name:
            attrs["name"] = name
        if state:
            attrs["state"] = state
        attrs.update({k: str(x) for k, x in props.items() if x is not None})
        if len(attrs) > (1 if name else 0) + (1 if state else 0):
            ET.SubElement(classes[cls], "part", attrs)

    def image(ref):
        return bitmap(ref) if ref is not None else None

    def font(decls, base=None, bold=None, underline=False):
        face = v.text(decls["fontface"]) if "fontface" in decls else (base or {}).get("face")
        size = v.number(decls["fontsize"]) if "fontsize" in decls else (base or {}).get("size")
        if face is None or size is None:
            return None
        weight = v.number(decls["fontweight"]) if "fontweight" in decls else None
        out = f"{face}, {size}"
        if bold or (bold is None and weight is not None and weight >= 600):
            out += ", Bold"
        if underline:
            out += ", Underline"
        return out

    def hot_underline(decls):
        return bool(decls.get("fontstyle")) and v.text(decls["fontstyle"]) == "underline"

    def border_fill(decls, background=None):
        fill = v.color(decls["background"]) if "background" in decls else None
        if (fill is None or fill[3] == 0) and background is not None:
            fill = background
        out = {"BgType": "BorderFill"}
        if fill is not None and fill[3] != 0:
            out.update(FillType="Solid", FillColor=rgb(fill))
        border = v.rect(decls["borderthickness"]) if "borderthickness" in decls else None
        bcolor = v.color(decls["bordercolor"]) if "bordercolor" in decls else None
        if border and bcolor and any(border):
            out.update(BorderColor=rgb(bcolor), BorderThickness=margins(border), BorderSize=max(border))
        else:
            out["BorderSize"] = 0
        pad = v.rect(decls["padding"]) if "padding" in decls else (0, 0, 0, 0)
        if pad and border:
            out["ContentMargins"] = margins(tuple(p + q for p, q in zip(pad, border)))
        return out

    # The pane: "taskpane"'s section list.
    pane = v.rules("taskpane", "element", "sectionlist")
    if pane:
        props = border_fill(pane)
        grad = v.gradient(pane.get("background", []))
        if grad:
            a, b, vertical = grad
            props.update(FillType="VertGradient" if vertical else "HorzGradient",
                         GradientColor1=rgb(a), GradientColor2=rgb(b))
        normal = v.rules("sectionss", "expando")
        m = v.rect(normal.get("margin", [])) or (0, 0, 0, 0)
        props["GroupSpacing"] = max(m[1], m[3])
        part("ExplorerBar", None, **props)

    # The groups: "sectionss" (normal) and "mainsectionss" (special: My
    # Computer's System Tasks, Control Panel's), their tasks in
    # "sectiontaskss" and "mainsectiontaskss".
    for kind, sheet, tasks in (("Normal", "sectionss", "sectiontaskss"),
                               ("Special", "mainsectionss", "mainsectiontaskss")):
        expando = v.rules(sheet, "expando")
        base_font = {"face": v.text(expando["fontface"]) if "fontface" in expando else None,
                     "size": v.number(expando["fontsize"]) if "fontsize" in expando else None}
        header = v.rules(sheet, "button", "header") or v.rules(sheet, "button")
        title_hot = v.rules(sheet, "element", "title", ("mousefocused",))
        head = {}
        bmp = image(v.bitmap(header.get("background", [])))
        border = v.rect(header.get("borderthickness", [])) or (0, 0, 0, 0)
        pad = v.rect(header.get("padding", [])) or (0, 0, 0, 0)
        if bmp:
            # A nine-grid bitmap: DirectUI stretches it by the element's
            # border thickness.
            head.update(BgType="ImageFile", ImageFile=bmp, SizingType="Stretch",
                        SizingMargins=margins(border))
        fg = v.color(header.get("foreground", []))
        part("ExplorerBar", f"{kind}GroupHead", **head,
             ContentMargins=margins(tuple(p + q for p, q in zip(pad, border))),
             Font=font(header, base_font), TextColor=rgb(fg) if fg else None)
        hot = v.color(title_hot.get("foreground", []))
        part("ExplorerBar", f"{kind}GroupHead", "Hot", TextColor=rgb(hot) if hot else None)
        # The arrow: "selected" is an expanded group, which shows Collapse.
        for name, flags in (("Expand", ()), ("Collapse", ("selected",))):
            normal = image(v.bitmap(v.rules(sheet, "element", "arrow", flags).get("content", [])))
            hot_img = image(v.bitmap(v.rules(sheet, "element", "arrow",
                                             flags + ("mousefocused",)).get("content", [])))
            # One image a state; placed inside the title bar's border and
            # padding, from its top right corner (as msstyles' Offsets are).
            for state, img in (("Normal", normal), ("Hot", hot_img or normal),
                               ("Pressed", hot_img or normal)):
                if img:
                    part("ExplorerBar", f"{kind}Group{name}", state, BgType="ImageFile",
                         ImageFile=img, ImageCount=1, SizingType="TrueSize",
                         OffsetType="TopRight", Offset=f"{-(border[2] + pad[2])} {border[1]}")
        # The body: the task list (the special group's shows its watermark
        # element's background).
        tasklist = v.rules(sheet, "tasklist", "tasklist")
        watermark = v.color(v.rules(sheet, "element", "watermark").get("background", []))
        body = border_fill(tasklist, watermark)
        links = v.rules(tasks, "button")
        link_title = v.rules(tasks, "element", "title")
        link_hot = v.rules(tasks, "element", "title", ("mousefocused",))
        # Each task (an "actiontask" or "destinationtask") has its margin.
        lm = (v.rect(v.rules(tasks, "actiontask").get("margin", []))
              or v.rect(links.get("margin", [])) or (0, 0, 0, 0))
        tp = v.rect(link_title.get("padding", [])) or (0, 0, 0, 0)
        lfg = v.color(links.get("foreground", []))
        part("ExplorerBar", f"{kind}GroupBackground", **body, Font=font(links, base_font, bold=False),
             TextColor=rgb(lfg) if lfg else None, LinkSpacing=lm[1], IconSpacing=tp[0])
        lhot = v.color(link_hot.get("foreground", []))
        underline = hot_underline(v.rules(tasks, "button", None, ("mousefocused",)))
        part("ExplorerBar", f"{kind}GroupBackground", "Hot", TextColor=rgb(lhot) if lhot else None,
             Font=font(links, base_font, bold=False, underline=True) if underline else None)
        if kind == "Normal":
            normal_font = base_font

    # The Details group's text ("NameSpaceItemInfoList").
    info = v.rules("NameSpaceItemInfoList", "namespaceiteminfo")
    name = v.rules("NameSpaceItemInfoList", "namespaceiteminfo", "InfoName")
    im = v.rect(info.get("margin", [])) or (0, 0, 0, 0)
    part("TaskPane", "Details", Font=font(info, normal_font, bold=False), LinkSpacing=im[1])
    part("TaskPane", "DetailsName", Font=font(name, normal_font))

    # The blockade over system folders ("These files are hidden."), in "main".
    blockade = v.rules("main", "element", "blockade")
    if blockade:
        part("Blockade", "Background", **border_fill(blockade))
        grad = v.gradient(v.rules("main", "element", "blockadeaccent").get("background", []))
        if grad:
            a, b, vertical = grad
            part("Blockade", "Accent", BgType="BorderFill", BorderSize=0,
                 FillType="VertGradient" if vertical else "HorzGradient",
                 GradientColor1=rgb(a), GradientColor2=rgb(b))
        for pname, eid in (("Title", "blockadetitle"), ("Message", "blockademessage"),
                           ("Link", "blockadecleartext")):
            d = v.rules("main", "element", eid)
            fg = v.color(d.get("foreground", []))
            pad = v.rect(d.get("padding", []))
            part("Blockade", pname, Font=font(d), TextColor=rgb(fg) if fg else None,
                 ContentMargins=margins(pad) if pad else None)
        if hot_underline(v.rules("main", "element", "blockadecleartext", ("mousefocused",))):
            part("Blockade", "Link", "Hot", Font=font(v.rules("main", "element", "blockadecleartext"),
                                                      underline=True))
    return root


def find_shellstyle(msstyles, color):
    """Shell/COLOR/shellstyle.dll beside the style, as XP finds it for the
    colour scheme (any case: Royale's folders are lower case)."""
    path = os.path.dirname(os.path.abspath(msstyles))
    for want in ("shell", color, "shellstyle.dll"):
        try:
            names = os.listdir(path)
        except OSError:
            return None
        match = [n for n in names if n.lower() == want.lower()]
        if not match:
            return None
        path = os.path.join(path, match[0])
    return path if os.path.isfile(path) else None


def import_shell(msstyles, pkg, variants):
    """Adds shell/COLOR.xml for each XP colour scheme with a shellstyle.dll,
    and names it in the variants."""
    done = {}
    for v in variants:
        color = v["color_key"]
        if color not in done:
            dll = find_shellstyle(msstyles, color)
            done[color] = None
            if dll:
                path = f"shell/{slug(color)}.xml"
                try:
                    pkg.add(path, shellstyle_xml(dll, pkg, color))
                    done[color] = path
                except (DuiError, pefile.PEFormatError) as e:
                    print(f"xd-theme-import: {dll}: {e}", file=sys.stderr)
        if done[color]:
            v["shell"] = done[color]


