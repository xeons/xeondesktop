"""Converts Windows visual styles into XeonDesktop theme packages.

    xd-theme-import [--folder] SOURCE OUTPUT

SOURCE is a .msstyles (Windows XP, Vista or 7) or a .theme file (which
names its .msstyles, wallpaper, sounds and cursors). OUTPUT is the
package: a NAME.xdtheme zip, or with --folder a folder of the same files.
docs/THEMES.md describes the format.

Reads the .msstyles with pefile; images are converted with GdkPixbuf.
"""
import argparse
import configparser
import io
import os
import re
import struct
import sys
import tempfile
import xml.etree.ElementTree as ET
import zipfile

try:
    import pefile
except ImportError:
    sys.exit("xd-theme-import: needs pefile (python-pefile, python3-pefile)")
