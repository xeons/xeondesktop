# SPDX-License-Identifier: MIT
# XeonDesktop's taskbar, Start menu and notification area under another
# wlroots compositor's session (sway, Hyprland, labwc, ...), in place of
# its own panel. Installed but not enabled; turn it on with
#   systemctl --user enable --now xeondesktop-taskbar.service
# It runs while graphical-session.target does, so the compositor's session
# must start that target (sway and labwc setups commonly do, Hyprland with
# uwsm). A XeonDesktop session starts its own shell, so it stays out of
# that one.

[Unit]
Description=XeonDesktop taskbar
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=!XDG_CURRENT_DESKTOP=XeonDesktop

[Service]
ExecStart=@BINDIR@/xd-shell --taskbar-only
# A crash restarts it, as xd-compositor restarts its shell; the compositor
# going away ends it cleanly.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
